[Unit]
Description=Task 14 Three-Tier Flask Application
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/task14/app
EnvironmentFile=/etc/task14-app.env
ExecStart=/opt/task14/venv/bin/gunicorn \
  --workers 3 \
  --bind 127.0.0.1:8000 \
  --timeout 60 \
  app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
